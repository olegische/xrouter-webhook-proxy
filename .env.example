# Environment
ENVIRONMENT=test

# Project
PROJECT_NAME=xrouter-webhook-proxy
VERSION=0.1.0

# Host
HOST=0.0.0.0
PORT=8220

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Carrot Quest
CARROT_QUEST_WEBHOOK_TOKEN="carrot-quest-service-token"

# Agent Service
AGENT_SERVICE_URL=http://localhost:8080
AGENT_SERVICE_TIMEOUT=30.0

# User Access Control
WHITELIST_USERS=[]  # Comma-separated list of user IDs
ENABLE_USER_WHITELIST=false  # Set to true to enable user whitelist filtering
